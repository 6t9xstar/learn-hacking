{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/6t9xstar/learn-hacking/resources/data/resources.schema.json",
  "title": "learn-hacking resource catalog",
  "description": "Machine-readable metadata for verified cybersecurity learning resources.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "url",
      "provider",
      "category",
      "level",
      "cost",
      "account_required",
      "hands_on",
      "free_details",
      "description",
      "verified"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 2,
        "description": "Official product or resource name."
      },
      "url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://",
        "description": "Canonical HTTPS URL, without affiliate or tracking parameters."
      },
      "provider": {
        "type": "string",
        "minLength": 2,
        "description": "Organization or maintainer that owns the resource."
      },
      "category": {
        "type": "string",
        "enum": [
          "foundations",
          "ethical-hacking",
          "network-security",
          "web-security",
          "mobile-security",
          "wireless-security",
          "cloud-security",
          "digital-forensics",
          "malware-analysis",
          "soc-blue-team",
          "red-team",
          "bug-bounty",
          "active-directory",
          "linux-security",
          "cryptography",
          "osint",
          "iot-security",
          "hardware-security",
          "blockchain-security",
          "ai-security",
          "devsecops",
          "application-security",
          "exploit-development",
          "threat-intelligence",
          "security-architecture",
          "governance-risk-compliance",
          "career-development",
          "training-grounds",
          "documentation",
          "books",
          "certifications",
          "ctf",
          "communities",
          "tools"
        ]
      },
      "level": {
        "type": "string",
        "enum": ["beginner", "intermediate", "advanced", "mixed"]
      },
      "cost": {
        "type": "string",
        "enum": ["free", "free-account", "freemium", "paid"]
      },
      "account_required": {
        "type": "boolean"
      },
      "hands_on": {
        "type": "boolean"
      },
      "free_details": {
        "type": "string",
        "minLength": 1,
        "description": "Exactly what is available without payment, including limitations."
      },
      "description": {
        "type": "string",
        "minLength": 10,
        "description": "One accurate sentence on what the learner gains."
      },
      "verified": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Date the URL and cost label were last checked (ISO 8601)."
      },
      "notes": {
        "type": "string",
        "description": "Optional prerequisites, caveats, or regional restrictions."
      }
    }
  }
}
