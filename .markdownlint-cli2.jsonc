{
  "config": {
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD029": false,
    "MD037": false,
    "MD033": {
      "allowed_elements": ["details", "summary", "br", "img", "div", "p", "kbd", "sup", "sub", "h1", "strong", "a", "em"]
    },
    "MD034": true,
    "MD036": false,
    "MD041": false,
    "MD046": {
      "style": "fenced"
    },
    "MD048": {
      "style": "backtick"
    }
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", ".github/ISSUE_TEMPLATE/**"]
}
